{
  "rules": {
    "games": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "voiceRooms": {
      "$roomId": {
        "answers": {
          "$userId": {
            "$targetId": {
              ".validate": "newData.hasChildren(['sdp', 'type', 'timestamp'])",
              ".write": "auth != null && (auth.uid == $userId || auth.uid == $targetId)"
            }
          }
        },
        "iceCandidates": {
          "$userId": {
            "$targetId": {
              "$candidateId": {
                ".validate": "newData.hasChildren(['candidate', 'sdpMLineIndex', 'sdpMid', 'timestamp'])",
                ".write": "auth != null && (auth.uid == $userId || auth.uid == $targetId)"
              }
            }
          }
        },
        "offers": {
          "$userId": {
            "$targetId": {
              ".validate": "newData.hasChildren(['sdp', 'type', 'timestamp'])",
              ".write": "auth != null && (auth.uid == $userId || auth.uid == $targetId)"
            }
          }
        },
        "participants": {
          "$userId": {
            ".validate": "newData.hasChildren(['id', 'name', 'email', 'isMuted', 'isActive', 'joinedAt'])",
            ".write": "auth != null && auth.uid == $userId"
          }
        }
      },
      ".indexOn": [
        "participants"
      ],
      ".read": "auth != null"
    }
  }
}
