rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin identity: the account that can approve new signups.
    // Keep in sync with ADMIN_EMAIL in src/adminConfig.ts
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'raimu456@gmail.com';
    }

    // Critical collections for authentication flow
    match /pendingUsers/{userId} {
      // Allow users to create their own pending user document during signup
      allow create: if request.auth != null && request.auth.uid == userId;
      // Users can read their own pending status; admin can read any single doc
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Listing is restricted: admin sees everything, members only see approved members
      // (client queries must include where('approved', '==', true))
      allow list: if isAdmin() || (request.auth != null && resource.data.approved == true);
      // Only the admin can approve / modify / remove signup requests
      allow update, delete: if isAdmin();
    }

    match /profiles/{userId} {
      // Allow users to read and write their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow authenticated users to read other profiles for community features
      allow read: if request.auth != null;
      // Allow profile creation during onboarding
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // Scrapbook posts — members only (login required to read).
    // Authenticated users can create; authors can edit/delete their own posts
    // (matched by author email); anyone logged in may update only the like
    // counters and the replies array (the like & comment actions).
    match /scrapbook/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.token.email == resource.data.authorEmail ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likeCount', 'replies', 'replyCount'])
      );
      allow delete: if request.auth != null &&
        request.auth.token.email == resource.data.authorEmail;
    }

    // Community posts/stories - members only (login required to read).
    // Authenticated users can create, authors can edit/delete, anyone logged in can like
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Authors can update/delete their own stories (matched by author email);
      // any logged-in user may update only the like counters
      allow update: if request.auth != null && (
        request.auth.token.email == resource.data.authorEmail ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
      );
      allow delete: if request.auth != null &&
        request.auth.token.email == resource.data.authorEmail;
    }

    // Royal Bank loan applications — members can submit; only the admin can
    // read or manage them (reviewed from the Firebase console / email).
    match /loanApplications/{applicationId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // Ashramam Exclusive engagement — members read; users manage own comments
    match /exclusiveStories/{storyId} {
      allow read: if request.auth != null;
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }

    // Beloved Articles — public read; members post comments
    match /belovedArticles/{articleId} {
      allow read: if true;
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }

    // Cinema Reviews — fully public: anyone can read and post a review
    // (no login needed). No edits; admin can delete spam from the console.
    match /cinemaReviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow delete: if isAdmin();
    }

    // Travel Diaries — private memory book. Only signed-in residents can
    // read; any resident can add a diary; only the author can edit/delete.
    match /travelDiaries/{diaryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        request.auth.token.email == resource.data.authorEmail;
    }

    // Unused legacy collections — no code in the app reads or writes these,
    // so they are denied outright (previously any signed-in user could read
    // and write them, e.g. everyone's messages).
    match /messages/{messageId} {
      allow read, write: if false;
    }
    match /notifications/{notificationId} {
      allow read, write: if false;
    }
    match /trips/{tripId} {
      allow read, write: if false;
    }
    match /events/{eventId} {
      allow read, write: if false;
    }
    match /hangouts/{hangoutId} {
      allow read, write: if false;
    }
    match /residents/{residentId} {
      allow read, write: if false;
    }
    match /users/{userId} {
      allow read, write: if false;
    }

    // Default-deny: any collection not listed above is inaccessible, so a
    // signed-in stranger can no longer write arbitrary documents anywhere.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
