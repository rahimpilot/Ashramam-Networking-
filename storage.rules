rules_version = '2';

// Firebase Storage rules — Ashramam Networking.
//
// cinema-reviews/: public review photos for the Cinema & Reviews page.
// Anyone can read them and upload images (max 5 MB, images only).
// Only the admin can delete.

service firebase.storage {
  match /b/{bucket}/o {
    match /cinema-reviews/{allPaths=**} {
      allow read: if true;
      allow create: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
  }
}
